        "cache_line_size": 64,
        "num_cores": 1
    },
    "storage": { "budget_bytes": 65536, "validation": "approximate static check" },
    "scoring": { "formula": "GMEAN(IPC_candidate / IPC_LRU)", "baseline_score": 1.0 }
}
